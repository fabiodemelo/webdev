---
// Docs layout: 3-col on desktop (sidebar, content, ToC). Sidebar groups docs
// by section and highlights the current entry.
import Site from './Site.astro';
import TechArticleJsonLd from '../components/TechArticleJsonLd.astro';
import { getCollection, type CollectionEntry } from 'astro:content';

type DocEntry = CollectionEntry<'docs'>;

interface Props {
  title: string;
  description: string;
  slug: string;
  section: string;
  updatedDate?: Date;
}
const { title, description, slug, section, updatedDate } = Astro.props;

const all = await getCollection('docs');
// Group by section, sort by order then title.
const sections: Record<string, DocEntry[]> = {};
for (const d of all) {
  const s = d.data.section;
  if (!sections[s]) sections[s] = [];
  sections[s].push(d);
}
for (const s of Object.keys(sections)) {
  sections[s].sort((a: DocEntry, b: DocEntry) => a.data.order - b.data.order || a.data.title.localeCompare(b.data.title));
}
const sectionOrder = ['Getting Started', 'Time Tracking', 'Timesheets & Approvals', 'Jobs & Customers', 'Jobs', 'Scheduling', 'People & Permissions', 'Reports', 'Field Tools', 'PinShot', 'Live Map', 'Company Settings', 'Administration', 'Integrations', 'Platform Admin', 'Reference'];
---
<Site title={`${title} | Klees Docs`} description={description}>
  <Fragment slot="head">
    <TechArticleJsonLd
      title={title}
      description={description}
      url={`https://www.klees.app/docs/${slug}/`}
      updatedDate={updatedDate}
      section={section}
    />
  </Fragment>
  <div class="max-w-7xl mx-auto px-6 py-10 lg:py-14 grid lg:grid-cols-[240px_1fr] gap-12">
    <aside class="lg:sticky lg:top-8 lg:self-start lg:max-h-[calc(100vh-4rem)] lg:overflow-y-auto">
      <nav aria-label="Docs navigation">
        <a href="/docs/" class="group inline-flex items-center gap-1.5 text-sm font-semibold text-primary-700 mb-6 hover:text-primary-800">
          <svg class="h-4 w-4 transition-transform group-hover:-translate-x-0.5" fill="none" stroke="currentColor" stroke-width="1.7" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M11 17l-5-5m0 0l5-5m-5 5h12"/></svg>
          All docs
        </a>
        {sectionOrder.filter(s => sections[s]).map(s => (
          <div class="mb-7">
            <h4 class="font-display text-sm font-bold text-ink mb-2">{s}</h4>
            <ul class="space-y-0.5 border-l border-slate-200">
              {sections[s].map((d: DocEntry) => (
                <li>
                  <a
                    href={`/docs/${d.slug}/`}
                    class={`-ml-px block border-l-2 pl-3 py-1.5 text-sm transition-colors ${d.slug === slug ? 'border-primary-500 font-semibold text-primary-700' : 'border-transparent text-slate-600 hover:border-slate-300 hover:text-primary-700'}`}
                    aria-current={d.slug === slug ? 'page' : undefined}
                  >
                    {d.data.title}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </nav>
    </aside>

    <article>
      <nav class="mb-4 flex items-center gap-2 text-sm text-slate-500">
        <a href="/docs/" class="font-medium text-slate-500 transition-colors hover:text-primary-700">Docs</a>
        <svg class="h-3.5 w-3.5 text-slate-300" fill="none" stroke="currentColor" stroke-width="1.7" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
        <span class="text-slate-500">{section}</span>
      </nav>
      <header class="mb-10 pb-8 border-b border-slate-200">
        <h1 class="balance font-display text-3xl sm:text-4xl font-bold tracking-tight text-ink leading-[1.1] mb-3">{title}</h1>
        <p class="pretty text-lg leading-relaxed text-slate-600">{description}</p>
        {updatedDate && (
          <p class="mt-4 text-sm text-slate-400">Updated {updatedDate.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })}</p>
        )}
      </header>
      <div class="prose prose-slate prose-lg max-w-none
        prose-headings:font-display prose-headings:tracking-tight prose-headings:text-ink prose-headings:font-bold
        prose-h2:text-2xl prose-h2:mt-12 prose-h2:mb-4 prose-h2:pb-2 prose-h2:border-b prose-h2:border-slate-200
        prose-h3:text-lg prose-h3:mt-8 prose-h3:mb-3
        prose-p:leading-relaxed prose-p:text-slate-600
        prose-li:text-slate-600 prose-li:marker:text-primary-500
        prose-a:text-primary-700 prose-a:font-medium prose-a:no-underline prose-a:underline-offset-2 hover:prose-a:underline hover:prose-a:text-primary-800
        prose-strong:text-ink prose-strong:font-semibold
        prose-blockquote:border-l-primary-300 prose-blockquote:bg-primary-50/40 prose-blockquote:py-1 prose-blockquote:not-italic prose-blockquote:text-slate-600 prose-blockquote:rounded-r-lg
        prose-code:text-primary-700 prose-code:bg-primary-50 prose-code:px-1.5 prose-code:py-0.5 prose-code:rounded-md prose-code:text-sm prose-code:font-medium prose-code:before:content-none prose-code:after:content-none
        prose-pre:rounded-xl prose-pre:border prose-pre:border-slate-800 prose-pre:bg-slate-900 prose-pre:text-slate-100
        prose-img:rounded-xl prose-img:border prose-img:border-slate-200
        prose-hr:border-slate-200
        prose-th:text-ink prose-th:font-semibold
        prose-thead:border-slate-200
      ">
        <slot />
      </div>
    </article>
  </div>
</Site>
