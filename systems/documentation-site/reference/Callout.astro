---
// Docs callout box. type = note | tip | warning | admin.
// `admin` marks steps only company owners/admins can do.
interface Props {
  type?: 'note' | 'tip' | 'warning' | 'admin';
  title?: string;
}
const { type = 'note', title } = Astro.props;
const styles = {
  note: { box: 'border-slate-200 bg-slate-50', icon: 'text-slate-500', label: 'Note', path: 'M12 8h.01M11 12h1v4h1' },
  tip: { box: 'border-emerald-200 bg-emerald-50', icon: 'text-emerald-600', label: 'Tip', path: 'M9 18h6M10 22h4M12 2a7 7 0 00-4 12.7c.6.5 1 1.3 1 2.3h6c0-1 .4-1.8 1-2.3A7 7 0 0012 2z' },
  warning: { box: 'border-amber-200 bg-amber-50', icon: 'text-amber-600', label: 'Important', path: 'M12 9v4M12 17h.01M10.3 3.9l-8 14A2 2 0 004 21h16a2 2 0 001.7-3l-8-14a2 2 0 00-3.4 0z' },
  admin: { box: 'border-primary-200 bg-primary-50', icon: 'text-primary-600', label: 'Admin only', path: 'M12 3l7 3v5c0 4.5-3 7.5-7 9-4-1.5-7-4.5-7-9V6z' },
}[type];
---
<div class={`my-5 flex gap-3 rounded-xl border px-4 py-3 ${styles.box}`}>
  <svg class={`mt-0.5 h-5 w-5 shrink-0 ${styles.icon}`} fill="none" stroke="currentColor" stroke-width="1.7" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d={styles.path}/></svg>
  <div class="min-w-0 text-sm leading-relaxed text-slate-700">
    <p class={`mb-0.5 font-semibold ${styles.icon}`}>{title ?? styles.label}</p>
    <slot />
  </div>
</div>
