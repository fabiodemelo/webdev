---
// Documentation screenshot. Pass `src` (a path under /docs-img/…) once the real
// screenshot is captured; until then it renders a labeled placeholder so pages
// are complete and the missing shots are obvious. `device` picks the frame
// aspect: 'desktop' (admin web) or 'mobile' (phone app).
interface Props {
  src?: string;
  alt: string;
  caption?: string;
  device?: 'desktop' | 'mobile';
}
const { src, alt, caption, device = 'desktop' } = Astro.props;
const isMobile = device === 'mobile';
---
<figure class="my-6">
  {src ? (
    <a href={src} target="_blank" rel="noreferrer" class="block">
      <img
        src={src}
        alt={alt}
        loading="lazy"
        class={`rounded-xl border border-slate-200 shadow-sm ${isMobile ? 'mx-auto max-h-[560px] w-auto' : 'w-full'}`}
      />
    </a>
  ) : (
    <div
      class={`flex flex-col items-center justify-center gap-2 rounded-xl border-2 border-dashed border-slate-300 bg-slate-50 text-slate-400 ${isMobile ? 'mx-auto aspect-[9/19] w-[240px]' : 'aspect-[16/9] w-full'}`}
    >
      <svg class="h-7 w-7" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M4 7h3l2-2h6l2 2h3v12H4z"/><circle cx="12" cy="13" r="3.5"/></svg>
      <span class="px-4 text-center text-xs font-medium">{isMobile ? 'Mobile' : 'Desktop'} screenshot — {alt}</span>
    </div>
  )}
  {caption && <figcaption class="mt-2 text-center text-sm text-slate-500">{caption}</figcaption>}
</figure>
