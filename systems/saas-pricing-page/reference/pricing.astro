---
// Pricing page. Cards driven by the live admin Plan list — fetched at build
// time from /api/v1/plans so editing a plan in /admin/platform/plans flows
// to this page on the next deploy. Falls back to hardcoded values if the
// API can't be reached during build.
//
// Comparison slider below stays static (competitor prices, refresh quarterly).
import Site from '../layouts/Site.astro';
import PageHero from '../components/site/PageHero.astro';
import CtaBand from '../components/site/CtaBand.astro';
import PricingJsonLd from '../components/PricingJsonLd.astro';
import { t } from '../i18n/strings';
const i = t('en');

const PLANS_URL = (import.meta.env.PUBLIC_API_URL ?? 'https://www.klees.app') + '/api/v1/plans';

interface PlanFeatures {
  yearlyPriceCents?: number;
  userLimit?: number | null;
  mostPopular?: boolean;
  list?: string[];
}
interface ApiPlan {
  id: string;
  slug: string;
  name: string;
  description: string;
  basePriceCents: number;
  seatPriceCents: number;
  includedSeats: number | null;
  trialDays: number;
  features: PlanFeatures;
}

// Static fallback — matches the seed shape so the build never breaks if the
// API is unreachable. Updated to mirror current production plans.
const FALLBACK_PLANS: ApiPlan[] = [
  {
    id: 'fallback-solo', slug: 'solo', name: 'Solo',
    description: 'Track your own time across customers and jobs. Built for freelancers who bill by the hour.',
    basePriceCents: 2000, seatPriceCents: 0, includedSeats: 0, trialDays: 14,
    features: { yearlyPriceCents: 20000, userLimit: 1, mostPopular: false, list: [
      'Single-user account (you only)',
      'Unlimited customers + jobs',
      'GPS-stamped clock in / clock out',
      'CSV + QuickBooks export for invoicing',
    ] },
  },
  {
    id: 'fallback-basic', slug: 'basic', name: 'Basic',
    description: 'Time tracking, scheduling, GPS, geofencing, jobs, crew clock, kiosk PIN, daily logs.',
    basePriceCents: 3100, seatPriceCents: 625, includedSeats: 0, trialDays: 30,
    features: { yearlyPriceCents: 31600, userLimit: 20, mostPopular: false, list: [
      'Up to 20 users',
      'Time entries, breaks, lunch tracking',
      'GPS-stamped clock in / clock out',
      'Mobile app (iOS + Android)',
    ] },
  },
  {
    id: 'fallback-standard', slug: 'standard', name: 'Standard',
    description: 'Time tracking, scheduling, GPS, geofencing, jobs, crew clock, kiosk PIN, daily logs.',
    basePriceCents: 3200, seatPriceCents: 625, includedSeats: 0, trialDays: 30,
    features: { yearlyPriceCents: 32600, userLimit: 100, mostPopular: true, list: [
      'Everything in Basic',
      'Up to 100 users',
      'Scheduling + shift swaps',
      'Live map of crew',
    ] },
  },
  {
    id: 'fallback-pro', slug: 'pro', name: 'Pro',
    description: 'Everything in Standard + PTO, multi-department, PinShot, advanced job costing.',
    basePriceCents: 4700, seatPriceCents: 775, includedSeats: 0, trialDays: 30,
    features: { yearlyPriceCents: 47900, userLimit: null, mostPopular: false, list: [
      'Everything in Standard', 'Unlimited users', 'PinShot identity verification',
    ] },
  },
  {
    id: 'fallback-enterprise', slug: 'enterprise', name: 'Enterprise',
    description: 'Everything in Pro + dedicated CSM, 99.99% SLA, SSO/SAML, custom integrations.',
    basePriceCents: 65000, seatPriceCents: 600, includedSeats: 100, trialDays: 30,
    features: { yearlyPriceCents: 663000, userLimit: null, mostPopular: false, list: [
      'Everything in Pro', '100 users included', 'Dedicated Customer Success Manager',
    ] },
  },
];

let plans: ApiPlan[] = FALLBACK_PLANS;
try {
  const res = await fetch(PLANS_URL, { headers: { Accept: 'application/json' } });
  if (res.ok) {
    const data = (await res.json()) as { items: ApiPlan[] };
    if (Array.isArray(data.items) && data.items.length > 0) plans = data.items;
  }
} catch {
  // Build-time fetch failed (network, API down) — keep fallback.
}

function cents(c: number): string {
  return (c / 100).toLocaleString('en-US', {
    style: 'currency', currency: 'USD',
    maximumFractionDigits: c % 100 === 0 ? 0 : 2,
  });
}
function monthlyFromYearly(yearlyCents: number): number {
  return Math.round(yearlyCents / 12);
}

// Comparison block: the slider always compares against Klees's CHEAPEST plan
// that fits the crew size (1 user → Solo, 15 users → Basic/Standard, …), plus
// the premium tier for the Pro column. All live plans go to the script.
const PRO = plans.find((p) => p.slug === 'pro') ?? FALLBACK_PLANS[3]!;
const KLEES = {
  pro: { base: PRO.basePriceCents / 100, seat: PRO.seatPriceCents / 100, included: 0 },
  all: plans.map((p) => ({
    name: p.name,
    base: p.basePriceCents / 100,
    seat: p.seatPriceCents / 100,
    included: p.includedSeats ?? 0,
    userLimit: p.features?.userLimit ?? null,
  })),
};

// Competitor public prices (Q2 2026 snapshot — refresh quarterly).
const COMPETITORS = [
  { name: 'ClockShark', std: { base: 40, seat: 8, included: 0 }, pro: { base: 60, seat: 10, included: 0 } },
  { name: 'busybusy', std: { base: 0, seat: 11.99, included: 0 }, pro: { base: 0, seat: 19.99, included: 0 } },
  { name: 'QuickBooks Time', std: { base: 20, seat: 10, included: 0 }, pro: { base: 40, seat: 10, included: 0 } },
];

const capabilities = [
  { cap: 'Full UI in English + Spanish + Portuguese', klees: 'yes', cs: 'no', bb: 'no', qb: 'no' },
  { cap: 'PinShot — photo verify + anti-spoof at clock-in', klees: 'yes', cs: 'no', bb: 'no', qb: 'no' },
  { cap: '51 nightly fraud & compliance audit checks', klees: 'yes', cs: 'no', bb: 'no', qb: 'no' },
  { cap: 'Auto-mileage from GPS while on the clock', klees: 'yes', cs: 'no', bb: 'no', qb: 'no' },
  { cap: 'Time-off requests + approvals, mobile to admin', klees: 'yes', cs: 'yes', bb: 'no', qb: 'yes' },
  { cap: 'Geofence clock reminders + GPS-loss protection', klees: 'yes', cs: 'limited', bb: 'no', qb: 'limited' },
  { cap: 'Only pay for enabled workers (1-hour grace)', klees: 'yes', cs: 'no', bb: 'no', qb: 'no' },
  { cap: 'Real-time live map (positions on a light interval)', klees: 'yes', cs: 'historical', bb: 'trails only', qb: 'no' },
  { cap: 'Spanish-first product design, not retrofitted', klees: 'yes', cs: 'no', bb: 'no', qb: 'no' },
  { cap: 'AI daily-log summary', klees: 'yes', cs: 'no', bb: 'no', qb: 'no' },
  { cap: 'Full audit log (every action recorded)', klees: 'yes', cs: 'no', bb: 'no', qb: 'limited' },
  { cap: 'White-label + custom domain (Pro tier)', klees: 'yes', cs: 'Enterprise only', bb: 'no', qb: 'no' },
  { cap: 'No-card 30-day trial on Standard / Pro', klees: 'yes', cs: '14 days, card', bb: '14 days, card', qb: '30 days, card' },
  { cap: 'Crew Clock — multi-person clock-in', klees: 'yes', cs: 'yes', bb: 'no', qb: 'no' },
  { cap: 'Modern 2026 stack (React Native + Fastify)', klees: 'yes', cs: 'no', bb: 'no', qb: 'no' },
  { cap: 'Marketing site in EN + ES + PT', klees: 'yes', cs: 'no', bb: 'no', qb: 'no' },
];
function cell(v: string) {
  if (v === 'yes') return { txt: '✓', cls: 'text-success-600 font-bold text-lg' };
  if (v === 'no') return { txt: '—', cls: 'text-slate-300' };
  return { txt: v, cls: 'text-slate-400 text-xs' };
}
---
<Site title="Pricing — Klees" description="Klees pricing: Standard $32 + $6.25/user, Pro $47 + $7.75/user, Enterprise $650/mo flat for 100 seats. 25-30% under ClockShark at every crew size. 30-day free trial." locale="en">
  <Fragment slot="head">
    <PricingJsonLd />
  </Fragment>

  <PageHero title={i.pricing.title} sub={i.pricing.sub}>
    <div class="reveal mt-8 flex flex-col items-center gap-2">
      <div id="billingToggle" data-billing="month" class="inline-flex items-center rounded-full border border-slate-200 bg-white p-1 shadow-sm">
        <button type="button" data-period="month" class="period-btn rounded-full bg-primary px-4 py-1.5 text-sm font-medium text-white shadow">Monthly</button>
        <button type="button" data-period="year" class="period-btn inline-flex items-center gap-1.5 rounded-full px-4 py-1.5 text-sm font-medium text-slate-600">
          Yearly
          <span class="rounded-full bg-success-50 px-1.5 py-0.5 text-[10px] uppercase tracking-wider text-success-700">Save 15%</span>
        </button>
      </div>
      <p id="yearlyNote" class="hidden max-w-2xl text-center text-xs italic text-slate-500">
        Yearly plans pay the base subscription up front. Active-user (seat) charges are still billed monthly on actual usage.
      </p>
    </div>
  </PageHero>

  <!-- ===== Plan cards — driven by /api/v1/plans (live admin data) ===== -->
  <section id="planGrid" class="max-w-[1440px] mx-auto grid gap-5 px-6 pb-16 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-5">
    {plans.map((p) => {
      const popular = !!p.features.mostPopular;
      const yearlyCents = p.features.yearlyPriceCents ?? Math.round(p.basePriceCents * 12 * 0.85);
      const yearlyMonthlyCents = monthlyFromYearly(yearlyCents);
      const userLimit = p.features.userLimit;
      const isEnterprise = p.slug === 'enterprise';
      const ctaHref = isEnterprise
        ? 'mailto:sales@klees.app?subject=Enterprise plan inquiry'
        : `/signup?plan=${p.slug}`;
      const ctaLabel = isEnterprise ? 'Talk to sales' : `Start ${p.trialDays}-day trial`;
      const userLine = userLimit
        ? `Up to ${userLimit} user${userLimit === 1 ? '' : 's'}`
        : 'Unlimited users';
      const list = p.features.list ?? [];
      const cardClass = isEnterprise
        ? 'border border-ink bg-ink text-white'
        : popular
          ? 'border-2 border-primary bg-white shadow-xl shadow-primary-500/10'
          : 'border border-slate-200 bg-white';
      const ctaClass = isEnterprise
        ? 'bg-white text-ink hover:bg-primary-100'
        : 'bg-ink text-white hover:bg-primary-700';
      return (
        <div class={`relative flex flex-col rounded-2xl p-6 ${cardClass}`}>
          {popular && (
            <span class="absolute -top-3 left-6 rounded-full bg-primary px-2.5 py-1 text-xs font-semibold text-white">Most popular</span>
          )}
          {isEnterprise && (
            <span class="absolute -top-3 right-6 rounded-full bg-signal-500 px-2.5 py-1 text-xs font-semibold text-ink">Best value · 100+</span>
          )}
          <h2 class="font-display text-xl font-bold">{p.name}</h2>
          <p class={`mt-1 min-h-[48px] text-sm line-clamp-3 ${isEnterprise ? 'text-white/60' : 'text-slate-500'}`}>{p.description}</p>

          <div class="mt-4">
            <p
              class="price-amount font-display text-4xl font-extrabold"
              data-monthly-cents={p.basePriceCents}
              data-yearly-monthly-cents={yearlyMonthlyCents}
            >{cents(p.basePriceCents)}<span class={`text-base font-normal ${isEnterprise ? 'text-white/50' : 'text-slate-400'}`}>/mo</span></p>
            <p class={`mt-1 text-xs ${isEnterprise ? 'text-white/60' : 'text-slate-500'}`}>
              <span class="monthly-sub">{cents(yearlyCents)}/yr</span>
              <span class={`yearly-sub hidden text-sm font-bold ${isEnterprise ? 'text-primary-300' : 'text-primary-700'}`}>
                {cents(yearlyCents)} billed yearly
              </span>
            </p>
            <p class={`mt-0.5 text-xs ${isEnterprise ? 'text-white/60' : 'text-slate-500'}`}>
              {p.seatPriceCents > 0 ? `+ ${cents(p.seatPriceCents)} / active user / month` : 'No per-seat charge'}
            </p>
          </div>

          <ul class={`mt-5 flex-1 space-y-2 text-sm ${isEnterprise ? 'text-white/80' : 'text-slate-700'}`}>
            <li class="flex gap-2"><svg class={`mt-0.5 h-4 w-4 flex-shrink-0 ${isEnterprise ? 'text-primary-300' : 'text-primary-600'}`} fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>{userLine}</li>
            {list.slice(0, 10).map((line) => (
              <li class="flex gap-2"><svg class={`mt-0.5 h-4 w-4 flex-shrink-0 ${isEnterprise ? 'text-primary-300' : 'text-primary-600'}`} fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>{line}</li>
            ))}
          </ul>

          <a href={ctaHref} class={`mt-6 block rounded-xl py-3 text-center font-semibold transition-colors ${ctaClass}`}>{ctaLabel}</a>
        </div>
      );
    })}
  </section>

  <!-- Toggle behaviour — swap each card's price + sub line between monthly + yearly. -->
  <script is:inline>
    (function () {
      const toggle = document.getElementById('billingToggle');
      if (!toggle) return;
      function applyPeriod(period) {
        toggle.setAttribute('data-billing', period);
        toggle.querySelectorAll('.period-btn').forEach((b) => {
          const on = b.getAttribute('data-period') === period;
          b.classList.toggle('bg-primary', on);
          b.classList.toggle('text-white', on);
          b.classList.toggle('shadow', on);
          b.classList.toggle('text-slate-600', !on);
        });
        document.querySelectorAll('.price-amount').forEach((el) => {
          const monthly = Number(el.getAttribute('data-monthly-cents') || '0');
          const yearlyMonthly = Number(el.getAttribute('data-yearly-monthly-cents') || '0');
          const cents = period === 'year' ? yearlyMonthly : monthly;
          const suffix = el.querySelector('span');
          const val = (cents / 100).toLocaleString('en-US', {
            style: 'currency', currency: 'USD',
            maximumFractionDigits: cents % 100 === 0 ? 0 : 2,
          });
          el.firstChild.nodeValue = val;
          if (suffix) suffix.textContent = '/mo';
        });
        document.querySelectorAll('.monthly-sub').forEach((el) => el.classList.toggle('hidden', period === 'year'));
        document.querySelectorAll('.yearly-sub').forEach((el) => el.classList.toggle('hidden', period !== 'year'));
        const note = document.getElementById('yearlyNote');
        if (note) note.classList.toggle('hidden', period !== 'year');
      }
      toggle.querySelectorAll('.period-btn').forEach((b) => {
        b.addEventListener('click', () => applyPeriod(b.getAttribute('data-period')));
      });
    })();
  </script>

  <!-- ===== Price comparison ===== -->
  <section class="border-t border-slate-200/70 bg-white">
    <div class="max-w-5xl mx-auto px-6 py-20">
      <div class="reveal text-center">
        <h2 class="balance font-display text-3xl md:text-4xl font-bold tracking-tight text-ink">See how Klees compares</h2>
        <p class="mt-2 text-slate-600">Slide to your crew size. Klees stays cheaper than every major field-service tool.</p>
      </div>

      <div class="reveal mx-auto mt-10 max-w-2xl">
        <label class="mb-2 block text-sm font-semibold text-slate-700">
          Crew size: <span id="crewLabel" class="font-bold text-primary-700">10</span> users
        </label>
        <input type="range" id="crewSlider" min="1" max="100" value="10" class="w-full accent-primary" />
        <div class="mt-1 flex justify-between text-xs text-slate-400">
          <span>1</span><span>20</span><span>40</span><span>60</span><span>80</span><span>100</span>
        </div>
      </div>

      <div id="savingsBanner" class="reveal mx-auto mt-8 max-w-5xl rounded-2xl border border-success-100 bg-success-50 px-6 py-5 text-center text-base font-semibold text-success-700 sm:text-lg"></div>

      <div class="reveal mt-8 overflow-x-auto">
        <table class="w-full overflow-hidden rounded-xl border border-slate-200 text-sm">
          <thead class="border-b border-slate-200 bg-slate-50">
            <tr>
              <th class="px-4 py-3 text-left font-semibold text-slate-600">Vendor</th>
              <th class="px-4 py-3 text-right font-semibold text-slate-600">Standard</th>
              <th class="px-4 py-3 text-right font-semibold text-slate-600">Pro / Premium</th>
            </tr>
          </thead>
          <tbody id="compBody"></tbody>
        </table>
      </div>

      <p class="mt-4 text-center text-xs text-slate-400">
        Prices in USD per month, billed monthly. Competitor prices from public pricing pages, Q2 2026 snapshot.
        Pro tier compared to the closest equivalent: ClockShark Pro, busybusy Pro, QuickBooks Time Elite.
      </p>
    </div>
  </section>

  <!-- ===== Klees-only differentiators ===== -->
  <section class="border-t border-slate-200/70 bg-[#f8fafc]">
    <div class="max-w-5xl mx-auto px-6 py-20">
      <div class="reveal text-center">
        <h2 class="balance font-display text-3xl md:text-4xl font-bold tracking-tight text-ink">What Klees ships that they don't</h2>
        <p class="mt-2 text-slate-600">Price is one thing. Capability is another.</p>
      </div>

      <div class="reveal mt-10 overflow-x-auto rounded-2xl border border-slate-200 bg-white">
        <table class="w-full text-sm">
          <thead class="border-b border-slate-200 bg-slate-50">
            <tr>
              <th class="px-4 py-3 text-left font-semibold text-slate-600">Capability</th>
              <th class="px-4 py-3 text-center font-semibold text-primary-700">Klees</th>
              <th class="px-4 py-3 text-center font-semibold text-slate-600">ClockShark</th>
              <th class="px-4 py-3 text-center font-semibold text-slate-600">busybusy</th>
              <th class="px-4 py-3 text-center font-semibold text-slate-600">QB Time</th>
            </tr>
          </thead>
          <tbody>
            {capabilities.map((row) => (
              <tr class="border-b border-slate-100 last:border-0">
                <td class="px-4 py-3 font-medium text-ink">{row.cap}</td>
                <td class={`px-4 py-3 text-center ${cell(row.klees).cls}`}>{cell(row.klees).txt}</td>
                <td class={`px-4 py-3 text-center ${cell(row.cs).cls}`}>{cell(row.cs).txt}</td>
                <td class={`px-4 py-3 text-center ${cell(row.bb).cls}`}>{cell(row.bb).txt}</td>
                <td class={`px-4 py-3 text-center ${cell(row.qb).cls}`}>{cell(row.qb).txt}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <p class="mt-4 text-center text-xs text-slate-400">
        Feature comparison from each vendor's public documentation, Q2 2026. Klees ships 11 capabilities the next-cheapest competitor doesn't.
      </p>
    </div>
  </section>

  <script is:inline define:vars={{ KLEES, COMPETITORS }}>
    // Vanilla JS — no React on marketing site. Compute total + percent
    // savings on every slider tick.
    const slider = document.getElementById('crewSlider');
    const crewLabel = document.getElementById('crewLabel');
    const compBody = document.getElementById('compBody');
    const banner = document.getElementById('savingsBanner');

    const fmt = (n) => `$${n.toFixed(0)}`;
    // includedSeats discount: only seats > included are billed at seat rate.
    const total = (p, seats) => {
      const included = p.included || 0;
      const billable = Math.max(0, seats - included);
      return p.base + p.seat * billable;
    };
    const savings = (klees, comp) => (comp <= 0 ? 0 : Math.round(((comp - klees) / comp) * 100));
    // Competitor delta vs Klees: positive => the competitor costs more (Klees cheaper).
    const deltaTag = (klees, comp) => {
      if (klees <= 0) return '';
      const pct = Math.round(((comp - klees) / klees) * 100);
      if (pct > 0) return ` <span class="ml-1 text-xs font-bold text-red-600">+${pct}%</span>`;
      if (pct < 0) return ` <span class="ml-1 text-xs font-bold text-red-600">${pct}%</span>`;
      return '';
    };

    function render() {
      const seats = parseInt(slider.value, 10);
      crewLabel.textContent = seats;

      // Cheapest Klees plan the crew actually fits into — the honest number.
      const eligible = KLEES.all.filter((p) => p.userLimit == null || p.userLimit >= seats);
      const best = eligible.reduce((a, b) => (total(a, seats) <= total(b, seats) ? a : b));
      const kleesStd = total(best, seats);
      const kleesBestName = best.name;
      const kleesPro = total(KLEES.pro, seats);

      const rows = [
        { name: `<strong class="text-primary-700">Klees</strong> <span class="text-xs text-slate-400">(${kleesBestName} plan)</span>`, std: kleesStd, pro: kleesPro, self: true },
        ...COMPETITORS.map((c) => ({
          name: c.name,
          std: total(c.std, seats),
          pro: total(c.pro, seats),
          self: false,
        })),
      ];

      compBody.innerHTML = rows
        .map((r) => {
          const stdPct = r.self ? '' : deltaTag(kleesStd, r.std);
          const proPct = r.self ? '' : deltaTag(kleesPro, r.pro);
          const priceCls = r.self ? 'text-xl md:text-2xl font-extrabold text-primary-700' : 'font-bold text-red-600';
          const rowCls = r.self ? 'bg-primary-50' : '';
          return `<tr class="border-b border-slate-100 ${rowCls}">
            <td class="px-4 py-3">${r.name}</td>
            <td class="px-4 py-3 text-right tabular-nums"><span class="${priceCls}">${fmt(r.std)}</span>${stdPct}</td>
            <td class="px-4 py-3 text-right tabular-nums"><span class="${priceCls}">${fmt(r.pro)}</span>${proPct}</td>
          </tr>`;
        })
        .join('');

      const competitorStds = COMPETITORS.map((c) => total(c.std, seats));
      const avgComp = competitorStds.reduce((a, b) => a + b, 0) / competitorStds.length;
      // Compare the CHEAPEST Klees tier at this size against the market average.
      const bestKlees = Math.min(kleesStd, kleesPro);
      const pctUnder = avgComp > 0 ? Math.round(((avgComp - bestKlees) / avgComp) * 100) : 0;
      const word = seats === 1 ? 'user' : 'users';
      banner.innerHTML =
        pctUnder > 0
          ? `At <span class="font-extrabold">${seats}</span> ${word}, the ${kleesBestName} plan at ${fmt(kleesStd)}/mo runs about <span class="font-extrabold">${pctUnder}%</span> under the market average.`
          : `At <span class="font-extrabold">${seats}</span> ${word}, Klees (${kleesBestName}, ${fmt(kleesStd)}/mo) is priced with the market on time tracking, and ahead on capability.`;
    }

    slider.addEventListener('input', render);
    render();
  </script>

  <CtaBand
    title="Start on any plan, free for 30 days."
    sub="No credit card. Cancel any time."
    primaryHref="/signup"
    primaryLabel="Start free"
    secondaryHref="/contact"
    secondaryLabel="Talk to sales"
  />
</Site>
